#This file is based on multi_account_rc:
# 4 registered account (eric, roger, 2*maurice)
# 1 unregistered account (andre)
# Note: on registration, usernames are username_random.

[sip]
sip_port=-1
sip_tcp_port=-1
sip_tls_port=-1
default_proxy=0

[proxy_0]
reg_proxy=<sip:sip.example.org;transport=tls>
reg_identity=sip:eric@sip.example.org
reg_expires=60
reg_sendregister=1
publish=0
dial_escape_plus=0
idkey=eric

[proxy_1]
reg_proxy=<sip:sip.example.org;transport=tcp>
reg_identity=sip:roger@sip.example.org
reg_expires=60
reg_sendregister=1
publish=0
dial_escape_plus=0
idkey=roger

[proxy_2]
reg_proxy=sip:auth1.example.org
reg_identity=sip:maurice@auth1.example.org
reg_expires=90
reg_sendregister=1
publish=0
dial_escape_plus=0
realm=auth1.example.org

[proxy_3]
reg_proxy=sip:auth1.example.org
reg_identity=sip:maurice@auth1.example.org
reg_expires=60
reg_sendregister=1
publish=0
dial_escape_plus=0
realm=auth1.example.org

[proxy_4]
reg_proxy=sip:sip.example.org
reg_identity=sip:andre@sip.example.org
reg_expires=60
reg_sendregister=0
publish=0
dial_escape_plus=0
realm=sip.example.org

[tester]
test_env=1

[storage]
call_logs_db_uri=null
friends_db_uri=null
