		<tr><td>rtp_symmetric</td><td>integer</td><td>0 or 1</td><td>0</td><td>Enable symmetric RTP assumption</td></tr>
		<tr><td>rtcp_enabled</td><td>integer</td><td>0 or 1</td><td>1</td><td>Enable RTCP</td></tr>
