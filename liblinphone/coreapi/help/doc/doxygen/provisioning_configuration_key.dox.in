/**
@defgroup group_provisioning_configuration_key Provisioning configuration keys
This document lists the supported sections and keys of the ini-style linphonerc configuration file.<br/>
This configuration can be served through https in order to remotely configure a linphone-sdk based application, see
linphone_core_set_provisioning_uri().<br/>
The <a href="https://gitlab.linphone.org/BC/public/flexisip-account-manager">Flexisip Account Manager</a> has built-in
support for remote provisioning Linphone or linphone-sdk based client applications.

@warning this page is under construction, not all section and keys are yet referenced.

<!-- TODO: ordering by feature group -->

<h2>SIP - section [<i>sip</i>]</h2>
The <i>sip</i> section represents a general configuration for SIP signaling features.
<table>
	<caption id="sip_parameters">SIP parameters</caption>
	<tr><th>Key<th>Value type<th>Possible values<th>Default value<th>API</th>
	\if DOXYFILE_USE_COPYBRIEF
		<th>Description</th>
	\endif
	</tr>
	<tr><td>sip_port</td><td>integer</td><td>-2 - 65535</td><td>-2=Don't Bind</td><td>linphone_core_set_transports() with linphone_transports_set_udp_port()</td><td>\copybrief linphone_transports_set_udp_port</td></tr>
	<tr><td>sip_tcp_port</td><td>integer</td><td>-2 - 65535</td><td>-2=Don't Bind</td><td>linphone_core_set_transports() with linphone_transports_set_tcp_port()</td><td>\copybrief linphone_transports_set_tcp_port</td></tr>
	<tr><td>sip_tls_port</td><td>integer</td><td>-2 - 65535</td><td>-2=Don't Bind</td><td>linphone_core_set_transports() with linphone_transports_set_tls_port()</td><td>\copybrief linphone_transports_set_tls_port</td></tr>
	<tr><td>default_proxy</td><td>integer</td><td>-1 - INT_MAX</td><td>-1</td><td>linphone_core_set_default_account()</td><td>\copybrief linphone_core_set_default_account</td></tr>
	<tr><td>100rel_support_level</td><td>integer</td><td>#LinphoneSupportLevel</td><td>NoSupport</td><td>linphone_core_set_tag_100rel_support_level()</td><td>\copybrief linphone_core_set_tag_100rel_support_level</td></tr>
	<tr><td>auto_send_ringing</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_auto_send_ringing_enabled()</td><td>\copybrief linphone_core_auto_send_ringing_enabled</td></tr>
	<tr><td>automatic_http_proxy_detection</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_automatic_http_proxy_detection_enabled()</td><td>\copybrief linphone_core_automatic_http_proxy_detection_enabled</td></tr>
	<tr><td>capability_negotiations_reinvite</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_capability_negotiation_reinvite_enabled()</td><td>\copybrief linphone_core_capability_negotiation_reinvite_enabled</td></tr>
	<tr><td>cfg_lines_merge</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_cfg_lines_merging_enabled()</td><td>\copybrief linphone_core_cfg_lines_merging_enabled</td></tr>
	<tr><td>client_cert_chain</td><td>string</td><td>A path</td><td>""</td><td>linphone_core_set_tls_cert_path()</td><td>\copybrief linphone_core_set_tls_cert_path</td></tr>
	<tr><td>client_cert_key</td><td>string</td><td>A key</td><td>""</td><td>linphone_core_set_tls_key_path()</td><td>\copybrief linphone_core_set_tls_key_path</td></tr>
	<tr><td>dscp</td><td>integer</td><td>DSCP</td><td>0</td><td>linphone_core_set_sip_dscp()</td><td>\copybrief linphone_core_set_sip_dscp</td></tr>
	<tr><td>http_proxy_host</td><td>string</td><td>a hostname</td><td>""</td><td>linphone_core_set_http_proxy_host()</td><td>\copybrief linphone_core_set_http_proxy_host</td></tr>
	<tr><td>http_proxy_port</td><td>integer</td><td>0 - 65535</td><td>3128</td><td>linphone_core_set_http_proxy_port()</td><td>\copybrief linphone_core_set_http_proxy_port</td></tr>
	<tr><td>in_call_timeout</td><td>integer</td><td>0–86400 (s)</td><td>0</td><td>linphone_core_set_in_call_timeout()</td><td>\copybrief linphone_core_set_in_call_timeout</td></tr>
	<tr><td>inc_timeout</td><td>integer</td><td>0–300 (s)</td><td>Android and IOS: 45. Else: 30</td><td>linphone_core_set_inc_timeout()</td><td>\copybrief linphone_core_set_inc_timeout</td></tr>
	<tr><td>keepalive_period</td><td>integer</td><td>0–60000 (ms)</td><td>30000</td><td>linphone_core_keep_alive_enabled()</td><td>\copybrief linphone_core_keep_alive_enabled</td></tr>
	<tr><td>linphone_specs</td><td>string</td><td>"groupchat/1.1"</td><td>""</td><td>linphone_core_set_linphone_specs_list()</td><td>\copybrief linphone_core_set_linphone_specs_list</td></tr>
	<tr><td>media_encryption_mandatory</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_is_media_encryption_mandatory()</td><td>\copybrief linphone_core_is_media_encryption_mandatory</td></tr>
	<tr><td>media_encryption</td><td>string</td><td>none, srtp, zrtp, dtls</td><td>none</td><td>linphone_core_set_media_encryption()</td><td>\copybrief linphone_core_set_media_encryption</td></tr>
	<tr><td>push_incoming_call_timeout</td><td>integer</td><td>seconds</td><td>15</td><td>linphone_core_set_push_incoming_call_timeout()</td><td>\copybrief linphone_core_set_push_incoming_call_timeout</td></tr>
	<tr><td>refresh_window</td><td>range</td><td>Range of seconds</td><td>90-90</td><td>linphone_core_set_refresh_window()</td><td>\copybrief linphone_core_set_refresh_window</td></tr>
	<tr><td>register_only_when_network_is_up</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_set_register_only_when_network_is_up()</td><td>\copybrief linphone_core_set_register_only_when_network_is_up</td></tr>
	<tr><td>root_ca</td><td>string</td><td>a path</td><td>""</td><td>linphone_core_set_root_ca()</td><td>\copybrief linphone_core_set_root_ca</td></tr>
	<tr><td>sdp_200_ack</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_sdp_200_ack_enabled()</td><td>\copybrief linphone_core_sdp_200_ack_enabled</td></tr>
	<tr><td>session_expires_enabled</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_session_expires_enabled()</td><td>\copybrief linphone_core_session_expires_enabled</td></tr>
	<tr><td>session_expires_min_value</td><td>integer</td><td>Positive number</td><td>0</td><td>linphone_core_set_session_expires_min_value()</td><td>\copybrief linphone_core_set_session_expires_min_value</td></tr>
	<tr><td>session_expires_refresher_value</td><td>integer</td><td>#LinphoneSessionExpiresRefresher</td><td>Unspecified</td><td>linphone_core_set_session_expires_refresher_value()</td><td>\copybrief linphone_core_set_session_expires_refresher_value</td></tr>
	<tr><td>session_expires_value</td><td>integer</td><td>0 or not lower than session_expires_min_value</td><td>0</td><td>linphone_core_set_session_expires_value()</td><td>\copybrief linphone_core_set_session_expires_value</td></tr>
	<tr><td>sip_update</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_set_enable_sip_update()</td><td>\copybrief linphone_core_set_enable_sip_update</td></tr>
	<tr><td>srtp_crypto_suites</td><td>string</td><td>List</td><td>"AEAD_AES_128_GCM, AES_CM_128_HMAC_SHA1_80, AEAD_AES_256_GCM, AES_256_CM_HMAC_SHA1_80"</td><td>linphone_core_set_srtp_crypto_suites()</td><td>\copybrief linphone_core_set_srtp_crypto_suites</td></tr>
	<tr><td>support_capability_negotiations</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_capability_negociation_enabled()</td><td>\copybrief linphone_core_capability_negociation_enabled</td></tr>
	<tr><td>supported</td><td>string</td><td>Tags</td><td>"replaces, outbound, gruu, path"</td><td>linphone_core_set_supported_tag()</td><td>\copybrief linphone_core_set_supported_tag</td></tr>
	<tr><td>tcap_line_merge</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_tcap_lines_merging_enabled()</td><td>\copybrief linphone_core_tcap_lines_merging_enabled</td></tr>
	<tr><td>transport_timeout</td><td>integer</td><td>Milliseconds</td><td>15000</td><td>linphone_core_set_sip_transport_timeout()</td><td>\copybrief linphone_core_set_sip_transport_timeout</td></tr>
	<tr><td>use_info</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_set_use_info_for_dtmf()</td><td>\copybrief linphone_core_set_use_info_for_dtmf</td></tr>
	<tr><td>use_ipv6</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_ipv6_enabled()</td><td>\copybrief linphone_core_ipv6_enabled</td></tr>
	<tr><td>use_rfc2833</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_set_use_rfc2833_for_dtmf()</td><td>\copybrief linphone_core_set_use_rfc2833_for_dtmf</td></tr>
	<tr><td>user_agent</td><td>string</td><td>A user-agent</td><td>PACKAGE_NAME/LIBLINPHONE_VERSION</td><td>linphone_core_set_user_agent()</td><td>\copybrief linphone_core_set_user_agent</td></tr>
	<tr><td>verify_server_certs</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_verify_server_certificates()</td><td>\copybrief linphone_core_verify_server_certificates</td></tr>
	<tr><td>verify_server_cn</td><td>integer</td><td>0 or 1</td><td>1</td><td>linphone_core_verify_server_cn()</td><td>\copybrief linphone_core_verify_server_cn</td></tr>
	<tr><td>zero_rtp_port_for_stream_inactive</td><td>integer</td><td>0 or 1</td><td>0</td><td>linphone_core_zero_rtp_port_for_stream_inactive_enabled()</td><td>\copybrief linphone_core_zero_rtp_port_for_stream_inactive_enabled</td></tr>
</table>
\if DOXYFILE_USE_DETAILS
<details>
	<summary>Show private variables</summary>
	<table>
		<caption id="private_sip_parameters">Private SIP parameters</caption>
		<tr><th>Key<th>Value type<th>Possible values<th>Default value<th>Description</th></tr>
		<tr><td>mwi_expires</td><td>integer</td><td>0 - 9999999</td><td>86400</td><td>The expiry time (in seconds) for message waiting indications (MWI) subscriptions</td></tr>
		<tr><td>accounts_channel_isolation</td><td>integer</td><td>0 or 1</td><td>0</td><td>Always use one SIP connection per account.</td></tr>
		<tr><td>account_strict_matching</td><td>integer</td><td>0 or 1</td><td>0</td><td>Only for tests. linphone_core_account_strict_matching_enabled()</td></tr>
		<tr><td>answer_with_own_numbering</td><td>integer</td><td>0 or 1</td><td>0</td><td>Set answer with own numbering policy</td></tr>
		<tr><td>auto_answer_replacing_calls</td><td>integer</td><td>0 or 1</td><td>0</td><td>Automatically answer replacing calls. Used for tests</td></tr>
		<tr><td>auto_net_state_mon</td><td>integer</td><td>0 or 1</td><td>1</td><td>Enable automatic network state monitoring</td></tr>
		<tr><td>bind_address</td><td>string</td><td>IP address</td><td>::0</td><td>Set SIP listening address</td></tr>
		<tr><td>bodyless_lists</td><td>string</td><td>SIP URI separated by ','</td><td>""</td><td>Bodyless friend list</td></tr>
		<tr><td>cnx_ip_to_0000_if_sendonly_enabled</td><td>integer</td><td>0 or 1</td><td>0</td><td>Use legacy method for send-only streams (use of 0.0.0.0 connection address)</td></tr>
		<tr><td>disable_media</td><td>integer</td><td>0 or 1</td><td>0</td><td>Disable media by ignoring SDP</td></tr>
		<tr><td>force_name_addr</td><td>integer</td><td>0 or 1</td><td>0</td><td>Force all SIP headers enclosing addresses to use the name-addr ABNF serialization</td></tr>
		<tr><td>handle_content_encoding</td><td>string</td><td>none, deflate, ...</td><td>deflate</td><td>Tells whether the given transport type is supported by the library..linphone_core_content_encoding_supported()</td></tr>
		<tr><td>notify_all_ringings</td><td>integer</td><td>0 or 1</td><td>0</td><td></td></tr>
		<tr><td>only_one_codec</td><td>integer</td><td>0 or 1</td><td>0</td><td>Enforce one codec selection policy during SDP offer/answer</td></tr>
		<tr><td>ping_pong_verification</td><td>integer</td><td>0 or 1</td><td>1</td><td>Enable check with Ping-Pong (RFC5626)</td></tr>
		<tr><td>pong_timeout</td><td>integer</td><td>seconds</td><td>10</td><td>Pong Timeout.</td></tr>
		<tr><td>prefer_ipv6</td><td>integer</td><td>0 or 1</td><td>1</td><td>Set IPV6 preference for SIP connections.</td></tr>
		<tr><td>reconnect_to_primary_asap</td><td>integer</td><td>0 or 1</td><td>0</td><td>Enable the reconnection to the primary server when it is up again asap.</td></tr>
		<tr><td>refresher_retry_after</td><td>integer</td><td>Milliseconds</td><td>60000</td><td>After a REGISTER connection failure, define the default retry-after period, if not given by server.</td></tr>
		<tr><td>save_auth_info</td><td>integer</td><td>0 or 1</td><td>1</td><td>if true, auth infos will be write in the config file when they are added to the list</td></tr>
		<tr><td>sip_tls_well_known_port</td><td>integer</td><td>0 - 65535</td><td>5061</td><td>The well known TLS port</td></tr>
		<tr><td>sip_well_known_port</td><td>integer</td><td>0 - 65535</td><td>5060</td><td>The well known TCP/UDP port</td></tr>
		<tr><td>tcp_tls_keepalive</td><td>integer</td><td>milliseconds</td><td>30000</td><td>SIP keep-alive interval on TLS.</td></tr>
		<tr><td>tls_certificate_subject_regexp</td><td>string</td><td>regex</td><td>""</td><td>the purpose of this handling is to a peer certificate for which there is no single subject matching the regexp given in the "tls_certificate_subject_regexp" property</td></tr>
		<tr><td>unreliable_connection_timeout</td><td>integer</td><td>seconds</td><td>120</td><td>Set the time interval in seconds after which a connection is considered to be unreliable because no data was received over it. belle_sip_stack_set_unreliable_connection_timeout().</td></tr>
		<tr><td>g</td><td>integer</td><td>0 or 1</td><td>0</td><td>Use no initial route header</td></tr>
		<tr><td>use_rport</td><td>integer</td><td>0 or 1</td><td>1</td><td>Use rport parameter in via</td></tr>
		<tr><td>vfu_with_info</td><td>integer</td><td>0 or 1</td><td>1</td><td>Enable VFU request using SIP INFO</td></tr>
	</table>
</details>
\endif

<h2>Audio - section [<i>sound</i>]</h2>
The <i>sound</i> section represents the audio configurations.
