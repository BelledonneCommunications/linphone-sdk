		<caption id="private_remote_contact_directory_parameters">Private Remote Contact directory parameters</caption>
		<tr><th>Key<th>Value type<th>Possible values<th>Default value<th>Description</th></tr>
		<tr><td>carddav_fields_for_user_input</td><td>string</td><td></td><td>""</td><td>List of comma separated VCard fields to match with the user input</td></tr>
		<tr><td>carddav_fields_for_domain</td><td>string</td><td></td><td>""</td><td>List of comma separated VCard fields to match for SIP domain</td></tr>
		<tr><td>carddav_use_exact_match_policy</td><td>integer</td><td>0 or 1</td><td>0</td><td>Whether the match must be exact or approximate (ignoring accents, case, ...)</td></tr>
		<tr><td>ldap_bind_dn</td><td>string</td><td></td><td>""</td><td>LDAP bind distinguished name</td></tr>
		<tr><td rowspan="2">ldap_auth_method</td><td rowspan="2">integer</td><td>0: anonymous</td><td rowspan="2">1</td><td rowspan="2">LDAP authentication method</td></tr>
		<tr><td>1: simple</td></tr>
		<tr><td>ldap_base_object</td><td>string</td><td></td><td>""</td><td>LDAP base object</td></tr>
