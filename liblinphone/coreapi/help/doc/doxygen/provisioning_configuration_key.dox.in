	<tr><td>delay_message_send_s</td><td>integer</td><td>any positive integer or 0</td><td>10</td><td>linphone_core_set_message_sending_delay()</td><td>\copybrief linphone_core_set_message_sending_delay</td></tr>
	<tr><td>delay_message_send_app_ext_s</td><td>integer</td><td>any positive integer or 0</td><td>3</td><td>linphone_core_set_message_sending_delay_app_ext()</td><td>\copybrief linphone_core_set_message_sending_delay_app_ext</td></tr>
